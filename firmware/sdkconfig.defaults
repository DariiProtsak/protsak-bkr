# ESP32-C5 (eco2, rev v1.0) — ESP-IDF v5.5.4
# esp32c5 більше не preview, збирати: idf.py set-target esp32c5

# WiFi CSI
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# Збільшити стек для CSI callback
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# UART швидкість — 921600 для високочастотного CSI
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# FreeRTOS tick rate — 1000Hz дозволяє vTaskDelay(1)=1ms замість 10ms
CONFIG_FREERTOS_HZ=1000

# Логування
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
